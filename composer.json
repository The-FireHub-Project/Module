{
  "name": "the-firehub-project/module",
  "description": "Modular application composition and lifecycle integration for The FireHub Project.",
  "type": "library",
  "keywords": ["php", "framework", "firehub", "application-modules", "modular-architecture", "module-system"],
  "homepage": "https://the-firehub-project.github.io/module",
  "license": "Apache-2.0",
  "require": {
    "php": "^8.5",

    "the-firehub-project/core-standard": "dev-develop",
    "the-firehub-project/runtime": ">=0.1.0 <1.0.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "the-firehub-project/phpstan-rules": "dev-develop",

    "the-firehub-project/testing": "dev-develop"
  },
  "minimum-stability": "stable",
  "autoload": {
    "psr-4": {
      "FireHub\\Module\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FireHub\\Tests\\Module\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Danijel Galić",
      "email": "danijel.galic@outlook.com",
      "homepage": "https://github.com/dieselxxx",
      "role": "Owner"
    }
  ],
  "support": {
    "email": "danijel.galic@outlook.com",
    "issues": "https://github.com/The-FireHub-Project/Module/issues",
    "forum": "https://github.com/orgs/The-FireHub-Project/discussions",
    "wiki": "https://github.com/The-FireHub-Project/Module/wiki",
    "source": "https://github.com/The-FireHub-Project/Module",
    "docs": "https://the-firehub-project.github.io/Module",
    "security": "https://github.com/The-FireHub-Project/Module/security/policy"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/The-FireHub-Project"
    }
  ],
  "config": {
    "prepend-autoloader": false,
    "optimize-autoloader": true,
    "platform-check": true
  },
  "extra": {
    "firehub": {
      "layer": "runtime",
      "edition": "standard",
      "role": "orchestration",
      "criticality": "medium"
    }
  }
}